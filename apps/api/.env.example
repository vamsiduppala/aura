# apps/api — local dev config. Copy to `.env.local` and fill in as needed.
# Both vars are OPTIONAL; the server runs fully on its defaults.

# Port the Fastify server listens on. Defaults to 8787. If you change it, also set
# VITE_API_URL in apps/web/.env.local to match.
# PORT=8787

# Where the local SQLite database file lives. Defaults to apps/api/data/aura.db (gitignored).
# Use :memory: for an ephemeral DB (what the tests use).
# AURA_DB_PATH=./data/aura.db
