# apps/api — local dev config. Copy to `.env` and fill in as needed. `.env` is gitignored;
# THIS file is committed, so it must never hold a real secret.
# Everything here is OPTIONAL except the Anthropic key, and that only gates the Mentor.

# Port the Fastify server listens on. Defaults to 8787. If you change it, also set
# VITE_API_URL in apps/web/.env.local to match.
# PORT=8787

# Where the local SQLite database file lives. Defaults to apps/api/data/aura.db (gitignored).
# Use :memory: for an ephemeral DB (what the tests use).
# AURA_DB_PATH=./data/aura.db

# ── Mentor (§4.7) ────────────────────────────────────────────────────────────
# The Mentor is the one feature that needs the network, and this key is the only thing that
# enables it. Server-side ONLY — M17: no API keys in the client, ever. Without it the server
# still starts and every other route still answers; /v1/mentor/* returns a 503 naming the
# missing key and the client falls back to the locally computed court, because a Mentor that
# invents an answer is worse than one that admits it is offline.
ANTHROPIC_API_KEY=

# Model policy per tier. Overridable here so tiers can shift without a code change (§4.7);
# the defaults live in src/mentor/policy.ts. Model IDs are deliberate config, not evergreen
# pointers — changing one is a prompt-regression run, not a typo fix.
# MENTOR_MODEL_DEFAULT=claude-opus-5
# MENTOR_MODEL_DEEP=claude-opus-5
# MENTOR_MODEL_PREMIUM=claude-fable-5
# MENTOR_MODEL_UTILITY=claude-haiku-4-5

# Per-user daily token budget. Soft cap degrades to the utility model, hard cap stops
# answering with a plain message rather than a truncated reading.
# MENTOR_BUDGET_SOFT=250000
# MENTOR_BUDGET_HARD=600000
