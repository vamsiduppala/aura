# apps/web — local dev config. Copy to `.env.local` and fill in as needed.
# Everything here is OPTIONAL: the app runs with sensible defaults and degrades gracefully.

# Where the local aura API (apps/api) lives. Defaults to http://localhost:8787.
# Only change this if you started the API on a different PORT.
# VITE_API_URL=http://localhost:8787

# Enables the LIVE Cosmic Mentor (Gemini). Without a key the mentor still works — it falls
# back to the deterministic, engine-only reply — so this is optional.
# WARNING: VITE_-prefixed vars are embedded in the client bundle and visible to users. Use a
# throwaway/dev key here; in production, proxy LLM calls through a server so the key isn't shipped.
# VITE_GEMINI_API_KEY=your-dev-key-here

# Which Gemini model the mentor calls. Defaults to gemini-2.0-flash.
# VITE_GEMINI_MODEL=gemini-2.0-flash
