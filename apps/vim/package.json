{
  "name": "@vim/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vimshottari — Vedic dasha timing, as a royal court. Dark neumorphic UI on the real ephemeris.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run build && cap sync",
    "android:add": "npm run build && cap add android && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap sync android && cap run android",
    "ios:add": "npm run build && cap add ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run build && cap sync ios && cap run ios"
  },
  "dependencies": {
    "@aura/engine": "*",
    "@aura/knowledge": "*",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/status-bar": "^6.0.2",
    "sharp": "^0.35.3",
    "vite-plugin-pwa": "^0.21.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
